// Tang Mega NEO Dock 60K / GW5AT-LV60PG484AC1/I0
// The BLE module is connected to J13 pin 39/40 only when SDRAM0 is not populated.

IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "rst_n" Y12;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// PMOD1: capacitive touch outputs, idle-low / active-high, internal pull-downs.
IO_LOC "key_in[0]" Y21;
IO_PORT "key_in[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "key_in[1]" Y22;
IO_PORT "key_in[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "key_in[2]" AB21;
IO_PORT "key_in[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "key_in[3]" AB22;
IO_PORT "key_in[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "key_in[4]" AA20;
IO_PORT "key_in[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "key_in[5]" AA21;
IO_PORT "key_in[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "key_in[6]" AA19;
IO_PORT "key_in[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "key_in[7]" AB20;
IO_PORT "key_in[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// PMOD0 LED8 example mapping; LED module is common-anode, active-low.
IO_LOC "led_out[0]" P19;
IO_PORT "led_out[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_out[1]" R19;
IO_PORT "led_out[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_out[2]" T21;
IO_PORT "led_out[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_out[3]" U21;
IO_PORT "led_out[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_out[4]" P16;
IO_PORT "led_out[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_out[5]" R17;
IO_PORT "led_out[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_out[6]" R18;
IO_PORT "led_out[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_out[7]" T18;
IO_PORT "led_out[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// J13 SDRAM0 connector: pin 39/N39 = C19, pin 40/P40 = C18.
IO_LOC "BLE_RX" C19;
IO_PORT "BLE_RX" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "BLE_TX" C18;
IO_PORT "BLE_TX" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ADS1115 I2C on the unused J13 SDRAM0 data pins (J13 pin 1/2).
// Do not populate SDRAM0 while these pins are used.
IO_LOC "ADC_SCL" E14;
IO_PORT "ADC_SCL" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ADC_SDA" E13;
IO_PORT "ADC_SDA" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Optical pluck gate moved from E13 (now ADS1115 SDA) to J13 pin 3.
IO_LOC "OPTICAL_IN" C15;
IO_PORT "OPTICAL_IN" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "I2S_BCLK" Y17;
IO_PORT "I2S_BCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "I2S_LRCK" AB17;
IO_PORT "I2S_LRCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "I2S_DIN" AA16;
IO_PORT "I2S_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
