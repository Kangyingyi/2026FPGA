module record_packetizer (
  sys_clk_d,
  n442_6,
  record_active,
  previous_enable,
  record_pcm_valid,
  uart_tx_busy,
  n1137_5,
  record_stop_cmd,
  record_pcm_sample,
  owner,
  n602_3,
  n631_221,
  n631_223,
  n632_221,
  n632_223,
  n633_221,
  n633_223,
  n634_221,
  n634_223,
  n635_221,
  n635_223,
  n636_221,
  n636_223,
  n637_221,
  n637_223,
  n638_221,
  n638_223,
  tx_index_6_9,
  record_tx_valid,
  tx_index,
  frame_sequence,
  checksum
)
;
input sys_clk_d;
input n442_6;
input record_active;
input previous_enable;
input record_pcm_valid;
input uart_tx_busy;
input n1137_5;
input record_stop_cmd;
input [7:0] record_pcm_sample;
input [0:0] owner;
