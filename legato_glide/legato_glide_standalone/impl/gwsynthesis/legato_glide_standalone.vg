module legato_top (
  sys_clk,
  rst_n,
  key_in,
  I2S_BCLK,
  I2S_LRCK,
  I2S_DIN,
  PA_EN
)
;
input sys_clk;
input rst_n;
input [7:0] key_in;
output I2S_BCLK;
output I2S_LRCK;
output I2S_DIN;
output PA_EN;
wire sys_clk_d;
wire rst_n_d;
wire n6_6;
wire active_Z;
wire I2S_DIN_d;
wire sample_tick_Z;
wire I2S_LRCK_d;
wire I2S_BCLK_d;
wire [7:0] key_in_d;
wire [7:0] key_state_Z;
wire [31:0] step_Z;
wire [15:0] audio_sample;
wire VCC;
wire GND;
  IBUF sys_clk_ibuf (
    .O(sys_clk_d),
    .I(sys_clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  IBUF key_in_0_ibuf (
    .O(key_in_d[0]),
    .I(key_in[0]) 
);
  IBUF key_in_1_ibuf (
    .O(key_in_d[1]),
    .I(key_in[1]) 
);
  IBUF key_in_2_ibuf (
    .O(key_in_d[2]),
    .I(key_in[2]) 
);
  IBUF key_in_3_ibuf (
    .O(key_in_d[3]),
    .I(key_in[3]) 
);
  IBUF key_in_4_ibuf (
    .O(key_in_d[4]),
    .I(key_in[4]) 
);
  IBUF key_in_5_ibuf (
    .O(key_in_d[5]),
    .I(key_in[5]) 
);
  IBUF key_in_6_ibuf (
    .O(key_in_d[6]),
    .I(key_in[6]) 
);
  IBUF key_in_7_ibuf (
    .O(key_in_d[7]),
    .I(key_in[7]) 
);
  OBUF I2S_BCLK_obuf (
    .O(I2S_BCLK),
    .I(I2S_BCLK_d) 
);
  OBUF I2S_LRCK_obuf (
    .O(I2S_LRCK),
    .I(I2S_LRCK_d) 
);
  OBUF I2S_DIN_obuf (
    .O(I2S_DIN),
    .I(I2S_DIN_d) 
);
  OBUF PA_EN_obuf (
    .O(PA_EN),
    .I(GND) 
);
  key_filter_8 keys (
    .sys_clk_d(sys_clk_d),
    .rst_n_d(rst_n_d),
    .key_in_d(key_in_d[7:0]),
    .n6_6(n6_6),
    .key_state_Z(key_state_Z[7:0])
);
  legato_pitch pitch (
    .sys_clk_d(sys_clk_d),
    .n6_6(n6_6),
    .sample_tick_Z(sample_tick_Z),
    .key_state_Z(key_state_Z[7:0]),
    .active_Z(active_Z),
    .step_Z(step_Z[31:0])
);
  legato_dds synth (
    .sys_clk_d(sys_clk_d),
    .n6_6(n6_6),
    .sample_tick_Z(sample_tick_Z),
    .active_Z(active_Z),
    .step_Z(step_Z[31:0]),
    .audio_sample_0(audio_sample[0]),
    .audio_sample_1(audio_sample[1]),
    .audio_sample_2(audio_sample[2]),
    .audio_sample_3(audio_sample[3]),
    .audio_sample_4(audio_sample[4]),
    .audio_sample_5(audio_sample[5]),
    .audio_sample_6(audio_sample[6]),
    .audio_sample_7(audio_sample[7]),
    .audio_sample_8(audio_sample[8]),
    .audio_sample_9(audio_sample[9]),
    .audio_sample_10(audio_sample[10]),
    .audio_sample_11(audio_sample[11]),
    .audio_sample_12(audio_sample[12]),
    .audio_sample_13(audio_sample[13]),
    .audio_sample_15(audio_sample[15])
);
  i2s_tx tx (
    .sys_clk_d(sys_clk_d),
    .n6_6(n6_6),
    .audio_sample_0(audio_sample[0]),
    .audio_sample_1(audio_sample[1]),
    .audio_sample_2(audio_sample[2]),
    .audio_sample_3(audio_sample[3]),
    .audio_sample_4(audio_sample[4]),
    .audio_sample_5(audio_sample[5]),
    .audio_sample_6(audio_sample[6]),
    .audio_sample_7(audio_sample[7]),
    .audio_sample_8(audio_sample[8]),
    .audio_sample_9(audio_sample[9]),
    .audio_sample_10(audio_sample[10]),
    .audio_sample_11(audio_sample[11]),
    .audio_sample_12(audio_sample[12]),
    .audio_sample_13(audio_sample[13]),
    .audio_sample_15(audio_sample[15]),
    .I2S_DIN_d(I2S_DIN_d),
    .sample_tick_Z(sample_tick_Z),
    .I2S_LRCK_d(I2S_LRCK_d),
    .I2S_BCLK_d(I2S_BCLK_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* legato_top */
