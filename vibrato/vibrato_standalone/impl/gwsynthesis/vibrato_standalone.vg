module i2s_tx (
  sys_clk_d,
  n14_6,
  mix_sum,
  audio_sample,
  I2S_LRCK_d,
  I2S_DIN_d,
  sample_tick_Z,
  I2S_BCLK_d
)
;
input sys_clk_d;
input n14_6;
input [19:19] mix_sum;
input [14:0] audio_sample;
output I2S_LRCK_d;
output I2S_DIN_d;
output sample_tick_Z;
output I2S_BCLK_d;
wire n84_4;
wire lrck_reg_7;
wire lrck_reg_9;
wire n212_38;
wire n267_7;
wire n266_7;
wire n264_7;
wire n33_7;
wire n32_7;
wire n31_7;
wire n30_7;
wire n29_7;
wire n14_5;
wire n84_5;
wire n212_39;
wire n212_40;
wire n212_41;
wire n30_8;
wire n212_42;
wire n212_43;
wire n212_44;
wire n212_45;
wire n212_46;
wire n212_47;
wire n212_48;
wire n212_49;
wire n212_50;
wire n212_51;
wire n310_8;
wire n470_6;
wire n265_9;
wire n269_10;
wire n268_9;
wire n34_9;
wire [4:0] clk_div;
wire [5:0] bit_count;
wire [15:0] left_hold;
wire VCC;
wire GND;
  LUT3 n84_s1 (
    .F(n84_4),
    .I0(bit_count[5]),
    .I1(bit_count[4]),
    .I2(n84_5) 
);
defparam n84_s1.INIT=8'h40;
  LUT4 lrck_reg_s4 (
    .F(lrck_reg_7),
    .I0(clk_div[4]),
    .I1(clk_div[3]),
    .I2(I2S_BCLK_d),
    .I3(n14_5) 
);
defparam lrck_reg_s4.INIT=16'h4000;
  LUT3 lrck_reg_s5 (
    .F(lrck_reg_9),
    .I0(bit_count[5]),
    .I1(n84_5),
    .I2(lrck_reg_7) 
);
defparam lrck_reg_s5.INIT=8'h40;
  LUT4 n212_s34 (
    .F(n212_38),
    .I0(n212_39),
    .I1(n212_40),
    .I2(n212_41),
    .I3(bit_count[5]) 
);
defparam n212_s34.INIT=16'h007F;
  LUT2 n267_s2 (
    .F(n267_7),
    .I0(clk_div[0]),
