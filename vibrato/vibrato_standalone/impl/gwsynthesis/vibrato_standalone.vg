module vibrato_top (
  sys_clk,
  rst_n,
  key_in,
  I2S_BCLK,
  I2S_LRCK,
  I2S_DIN,
  PA_EN
)
;
input sys_clk;
input rst_n;
input [7:0] key_in;
output I2S_BCLK;
output I2S_LRCK;
output I2S_DIN;
output PA_EN;
wire sys_clk_d;
wire rst_n_d;
wire n14_6;
wire I2S_LRCK_d;
wire I2S_DIN_d;
wire sample_tick_Z;
wire I2S_BCLK_d;
wire [7:0] key_in_d;
wire [7:0] key_state_Z;
wire [19:19] mix_sum;
wire [14:0] audio_sample;
wire VCC;
wire GND;
  IBUF sys_clk_ibuf (
    .O(sys_clk_d),
    .I(sys_clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  IBUF key_in_0_ibuf (
    .O(key_in_d[0]),
    .I(key_in[0]) 
);
  IBUF key_in_1_ibuf (
    .O(key_in_d[1]),
    .I(key_in[1]) 
);
  IBUF key_in_2_ibuf (
    .O(key_in_d[2]),
    .I(key_in[2]) 
);
  IBUF key_in_3_ibuf (
    .O(key_in_d[3]),
    .I(key_in[3]) 
);
  IBUF key_in_4_ibuf (
    .O(key_in_d[4]),
    .I(key_in[4]) 
);
  IBUF key_in_5_ibuf (
    .O(key_in_d[5]),
    .I(key_in[5]) 
);
  IBUF key_in_6_ibuf (
    .O(key_in_d[6]),
    .I(key_in[6]) 
);
  IBUF key_in_7_ibuf (
    .O(key_in_d[7]),
    .I(key_in[7]) 
);
  OBUF I2S_BCLK_obuf (
    .O(I2S_BCLK),
    .I(I2S_BCLK_d) 
);
  OBUF I2S_LRCK_obuf (
    .O(I2S_LRCK),
    .I(I2S_LRCK_d) 
);
  OBUF I2S_DIN_obuf (
    .O(I2S_DIN),
    .I(I2S_DIN_d) 
);
  OBUF PA_EN_obuf (
    .O(PA_EN),
    .I(GND) 
);
  key_filter_8 keys (
    .sys_clk_d(sys_clk_d),
    .rst_n_d(rst_n_d),
    .key_in_d(key_in_d[7:0]),
    .n14_6(n14_6),
    .key_state_Z(key_state_Z[7:0])
);
  vibrato_dds synth (
    .sys_clk_d(sys_clk_d),
    .n14_6(n14_6),
    .sample_tick_Z(sample_tick_Z),
    .key_state_Z(key_state_Z[7:0]),
    .mix_sum(mix_sum[19]),
    .audio_sample(audio_sample[14:0])
);
  i2s_tx tx (
    .sys_clk_d(sys_clk_d),
    .n14_6(n14_6),
    .mix_sum(mix_sum[19]),
    .audio_sample(audio_sample[14:0]),
    .I2S_LRCK_d(I2S_LRCK_d),
    .I2S_DIN_d(I2S_DIN_d),
    .sample_tick_Z(sample_tick_Z),
    .I2S_BCLK_d(I2S_BCLK_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* vibrato_top */
